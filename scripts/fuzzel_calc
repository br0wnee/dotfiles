#!/bin/bash

# 1. Define the path to our special calculator config
CALC_CONFIG="$HOME/.config/fuzzel/calc.ini"

# 2. Get the math expression from fuzzel.
#    We now add the '--config' flag.
query=$(echo | fuzzel -d \
    --config="$CALC_CONFIG" \
    -l 0 \
    --placeholder "Enter calculation...")

# 3. If the query is empty (user pressed Esc), do nothing.
if [ -z "$query" ]; then
    exit 0
fi

# 4. Calculate the result using bc (basic calculator).
result=$(echo "$query" | bc -l 2>&1)

# 5. Check if bc failed.
if [ $? -ne 0 ] || [[ "$result" == *"error"* ]]; then
    notify-send "Calculator Error" "Error: $result"
    exit 1
fi

# 6. Success! Copy the result to the clipboard.
echo -n "$result" | wl-copy

# 7. Show the successful result as a notification.
notify-send "Calculator Result" "$query = $result"
