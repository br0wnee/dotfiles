#!/bin/bash

# 1. Find the file
#    We use 'locate' for instant results.
#    -i = case-insensitive
#    -r "^$HOME" = regex to search *only* for paths that start with your home dir.
selected_file=$(locate -i -r "^$HOME" | fuzzel -d --placeholder "Find file in ~/")

# 2. If user pressed Esc, exit
if [ -z "$selected_file" ]; then
    exit 0
fi

# 3. Ask what to do with the file
#    We pipe our action list directly into a new fuzzel instance.
action=$(echo -e "Open\nCopy Path\nOpen Directory" | fuzzel -d -l 3 --placeholder "Action:")

# 4. Handle the chosen action
case "$action" in
    "Open")
        xdg-open "$selected_file"
        ;;
    "Copy Path")
        echo -n "$selected_file" | wl-copy
        notify-send "Path Copied" "$selected_file"
        ;;
    "Open Directory")
        # 'dirname' gets the directory path from the full file path
        dir=$(dirname "$selected_file")
        xdg-open "$dir"
        ;;
    *)
        # User pressed Esc on the second menu
        exit 0
        ;;
esac
